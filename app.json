{
  "expo": {
    "name": "NatureLens",
    "slug": "naturelens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "naturelens",
    "splash": {
      "backgroundColor": "#0E1512"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.naturelens"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F5EE"
      },
      "package": "app.naturelens"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow this app to use the camera to scan plants.",
          "photosPermission": "Allow this app to access your photos to identify plants."
        }
      ],
      "expo-localization"
    ]
  }
}
